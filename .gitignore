# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# datasynth-ui (Tauri + Svelte)
crates/datasynth-ui/node_modules/
crates/datasynth-ui/build/
crates/datasynth-ui/.svelte-kit/
crates/datasynth-ui/package-lock.json
crates/datasynth-ui/playwright-report/
crates/datasynth-ui/test-results/

# mdBook build output (source is tracked, build output is not)
docs/book/book/

# LaTeX temporary files
*.aux
*.log
*.out
*.toc
*.synctex.gz

# Output directories
output/
demo-output/
test_output/

# Golden-test diff artifacts (regenerable; tracked goldens live alongside)
**/tests/golden/*.actual

# E2E test artifacts
crates/datasynth-ui/screenshots/

# Python
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
.eggs/
.venv/
venv/
*.whl
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml
.env

# Git worktrees
.worktrees/

# Paper submission artifacts and local notes (may contain credentials/drafts)
paper/arxiv-metadata.txt
paper/arxiv-submission.tar
paper/main.bbl
paper/main.blg
paper/tmp/

# v5.0 XXL VM verification artifacts (large binary blobs, regenerable)
docs/superpowers/verification-runs/

# GNN fraud-detection showcase — large training artefacts kept out of git
data/ml/
models/ml/
*.pt
*.pkl
.gnn-venv/

# Superpowers brainstorming session artifacts (visual companion mockups)
.superpowers/

# Per-project Claude Code state (settings, transcripts) — local-only
.claude/

# Playwright MCP capture artifacts
.playwright-mcp/

# Hugging Face dataset staging + output dirs (regenerable, large)
hf_*_staging/
hf_*_output/
hf_staging/
hf_je_output/

# Browser-captured preview screenshots from spaces/* (regenerable)
spaces/*/preview-live.png
