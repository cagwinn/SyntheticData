# Always check golden test fixtures out with LF line endings, regardless
# of platform `core.autocrlf` setting.  The fixture is generated by
# `serde_json::to_string_pretty` which always emits `\n` — Windows
# autocrlf would otherwise turn the checked-out copy into `\r\n` and
# break the byte-identity comparison.
crates/datasynth-group/tests/golden/*.json text eol=lf

# Apply the same rule to all golden / fixture directories proactively.
crates/*/tests/golden/** text eol=lf
crates/*/tests/fixtures/** text eol=lf
